# 本机运行数据、登录凭据、聊天快照与下载的外部程序
.local/
.tmp/
.env
.env.*
!.env.example

# Python 和系统文件
__pycache__/
*.py[cod]
.DS_Store

# 本地开发记录，不作为项目文档发布
/task_plan.md
/findings.md
/progress.md

# Desktop development and packaged applications
node_modules/
dist/
*.spec

# Local native push platform credentials
/mobile/android-push/google-services.json
/mobile/android-push/.gradle/
/mobile/android-push/build/
/mobile/android-push/local.properties

# HarmonyOS SDK/cache, local signing and resources generated from shared sources
/mobile/harmony/.hvigor/
/mobile/harmony/.idea/
/mobile/harmony/oh_modules/
/mobile/harmony/entry/oh_modules/
# The pinned CLI generates these for the dependency-free app and module.
/mobile/harmony/oh-package-lock.json5
/mobile/harmony/entry/oh-package-lock.json5
/mobile/harmony/entry/build/
/mobile/harmony/build/
/mobile/harmony/local.properties
/mobile/harmony/*.p12
/mobile/harmony/*.p7b
/mobile/harmony/*.cer
/mobile/harmony/AppScope/resources/base/media/app_icon.png
/mobile/harmony/entry/src/main/resources/base/media/app_icon.png
/mobile/harmony/entry/src/main/resources/rawfile/*.js
